    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:tui": "npm run build && bun test test/tui",
    "test:host": "npm run build && node scripts/host-tests.mjs",
    "test:stock": "npm run build && bun test test/stock",
    "icons": "node scripts/check-icons.mjs",
    "actionlint": "node scripts/actionlint.mjs",
    "lint": "node scripts/check-forbidden.mjs --self-test && node scripts/check-forbidden.mjs && node scripts/check-copies.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run lint && npm run icons && npm run actionlint && npm run test:pack && npm run test:tui && npm run test:host && npm run test:stock",
    "e2e": "npm run build && bun scripts/e2e-live.mjs",
    "drift": "node scripts/drift.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
