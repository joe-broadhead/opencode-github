{
  "$comment": [
    "Arguments for npm run e2e: one case per catalogued read tool of the default toolsets, except the hidden ui_get.",
    "A string that is exactly {name} becomes values.name with its type; {name} inside a longer string is replaced with its text.",
    "Set org and team to an organization and team the token can read (read:org), and writable to a repository the token can push to; listing collaborators needs push access.",
    "On the writable repository, set workflow, run and job to a workflow file name and a run and job ID, and the alert and finding numbers to ones that exist; security alerts need admin or security-manager access. Set discussion_owner, discussion_repo and discussion to a repository with discussions.",
    "The issue and pull request number, label, branch, commit, path and tag must exist. Update them here if GitHub changes."
  ],
  "values": {
    "owner": "octocat",
    "repo": "Hello-World",
    "branch": "master",
    "commit": "7fd1a60b01f91b314f59955a4e4d4e80d8edf11d",
    "path": "README",
    "issue": 6,
    "pull": 6,
    "label": "bug",
    "releases_owner": "github",
    "releases_repo": "github-mcp-server",
    "tag": "v2.0.3",
    "org": "",
    "team": "",
    "writable_owner": "joe-broadhead",
    "writable_repo": "opencode-github",
    "workflow": "",
    "run": "",
    "job": "",
    "code_quality_finding": "",
    "code_scanning_alert": "",
    "secret_scanning_alert": "",
    "dependabot_alert": "",
    "ghsa": "GHSA-jfh8-c2jp-5v3q",
    "discussion_owner": "",
    "discussion_repo": "",
    "discussion": ""
  },
  "cases": [
    { "tool": "get_me", "args": {} },
    { "tool": "get_teams", "args": {} },
    { "tool": "get_team_members", "args": { "org": "{org}", "team_slug": "{team}" } },
    { "tool": "search_users", "args": { "query": "octocat", "perPage": 5 } },
    { "tool": "search_orgs", "args": { "query": "github", "perPage": 5 } },

    { "tool": "get_commit", "args": { "owner": "{owner}", "repo": "{repo}", "sha": "{commit}" } },
    { "tool": "get_file_contents", "args": { "owner": "{owner}", "repo": "{repo}", "path": "{path}" } },
    { "tool": "get_latest_release", "args": { "owner": "{releases_owner}", "repo": "{releases_repo}" } },
    { "tool": "get_release_by_tag", "args": { "owner": "{releases_owner}", "repo": "{releases_repo}", "tag": "{tag}" } },
    { "tool": "get_tag", "args": { "owner": "{releases_owner}", "repo": "{releases_repo}", "tag": "{tag}" } },
    { "tool": "list_branches", "args": { "owner": "{owner}", "repo": "{repo}", "perPage": 5 } },
    { "tool": "list_commits", "args": { "owner": "{owner}", "repo": "{repo}", "sha": "{branch}", "perPage": 5 } },
    { "tool": "list_releases", "args": { "owner": "{releases_owner}", "repo": "{releases_repo}", "perPage": 5 } },
    { "tool": "list_repository_collaborators", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}", "perPage": 5 } },
    { "tool": "list_tags", "args": { "owner": "{releases_owner}", "repo": "{releases_repo}", "perPage": 5 } },
    { "tool": "search_code", "args": { "query": "Hello repo:{owner}/{repo}", "perPage": 5 } },
    { "tool": "search_commits", "args": { "query": "Merge repo:{owner}/{repo}", "perPage": 5 } },
    { "tool": "search_repositories", "args": { "query": "repo:{owner}/{repo}", "perPage": 5 } },

    { "tool": "get_label", "args": { "owner": "{owner}", "repo": "{repo}", "name": "{label}" } },
    { "tool": "issue_read", "args": { "method": "get", "owner": "{owner}", "repo": "{repo}", "issue_number": "{issue}" } },
    { "tool": "list_issue_fields", "args": { "owner": "{org}" } },
    { "tool": "list_issue_types", "args": { "owner": "{org}" } },
    { "tool": "list_issues", "args": { "owner": "{owner}", "repo": "{repo}", "perPage": 5 } },
    { "tool": "search_issues", "args": { "query": "repo:{owner}/{repo}", "perPage": 5 } },

    { "tool": "list_pull_requests", "args": { "owner": "{owner}", "repo": "{repo}", "state": "all", "perPage": 5 } },
    { "tool": "pull_request_read", "args": { "method": "get", "owner": "{owner}", "repo": "{repo}", "pullNumber": "{pull}" } },
    { "tool": "search_pull_requests", "args": { "query": "repo:{owner}/{repo}", "perPage": 5 } },

    { "tool": "actions_list", "args": { "method": "list_workflows", "owner": "{writable_owner}", "repo": "{writable_repo}", "perPage": 5 } },
    { "tool": "actions_get", "args": { "method": "get_workflow", "owner": "{writable_owner}", "repo": "{writable_repo}", "resource_id": "{workflow}" } },
    { "tool": "get_job_logs", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}", "job_id": "{job}", "return_content": true, "tail_lines": 20 } },
    { "tool": "get_repository_tree", "args": { "owner": "{owner}", "repo": "{repo}" } },
    { "tool": "list_label", "args": { "owner": "{owner}", "repo": "{repo}" } },

    { "tool": "get_code_quality_finding", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}", "findingNumber": "{code_quality_finding}" } },
    { "tool": "list_code_scanning_alerts", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}" } },
    { "tool": "get_code_scanning_alert", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}", "alertNumber": "{code_scanning_alert}" } },
    { "tool": "list_secret_scanning_alerts", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}" } },
    { "tool": "get_secret_scanning_alert", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}", "alertNumber": "{secret_scanning_alert}" } },
    { "tool": "list_dependabot_alerts", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}" } },
    { "tool": "check_dependency_vulnerabilities", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}", "dependencies": [{ "ecosystem": "npm", "name": "lodash", "version": "4.17.15" }] } },
    { "tool": "get_dependabot_alert", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}", "alertNumber": "{dependabot_alert}" } },
    { "tool": "get_global_security_advisory", "args": { "ghsaId": "{ghsa}" } },
    { "tool": "list_global_security_advisories", "args": {} },
    { "tool": "list_org_repository_security_advisories", "args": { "org": "{org}" } },
    { "tool": "list_repository_security_advisories", "args": { "owner": "{writable_owner}", "repo": "{writable_repo}" } },

    { "tool": "list_discussion_categories", "args": { "owner": "{discussion_owner}", "repo": "{discussion_repo}" } },
    { "tool": "list_discussions", "args": { "owner": "{discussion_owner}", "repo": "{discussion_repo}" } },
    { "tool": "get_discussion", "args": { "owner": "{discussion_owner}", "repo": "{discussion_repo}", "discussionNumber": "{discussion}" } },
    { "tool": "get_discussion_comments", "args": { "owner": "{discussion_owner}", "repo": "{discussion_repo}", "discussionNumber": "{discussion}" } }
  ]
}
